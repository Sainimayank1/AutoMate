# Base URL of the AutoMate API (NestJS), including the version prefix.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: map tiles for trip routes ({z}/{x}/{y}). Unset = OpenStreetMap's tile server, which is
# fine for light use only (its usage policy); point production at a tile provider of your choice.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
