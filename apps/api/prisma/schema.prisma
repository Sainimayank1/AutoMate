// Conventions: docs/architecture/database.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased (the shared schema normalises it), so uniqueness is case-insensitive.
  email           String   @unique
  /// argon2id hash. The plain password is never stored or logged.
  passwordHash    String   @map("password_hash")
  name            String
  termsAcceptedAt DateTime @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  vehicles          Vehicle[]
  fuelEntries       FuelEntry[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]

  @@map("users")
}

/// One signed-in device. Holds only the SHA-256 hash of its refresh token, which rotates on every refresh.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  /// "Keep me signed in": a 30-day persistent cookie instead of a browser-session cookie.
  persistent Boolean
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AMT
  IMT
  CVT
  DCT
  AUTOMATIC
}

enum VehicleCategory {
  HATCHBACK
  SEDAN
  SUV
  MUV
  OTHER
}

enum OwnershipType {
  OWNED
  FINANCED
}

/// A vehicle in a user's garage (MODULES.md M2). Mirrors `createVehicleSchema` in @automate/shared.
model Vehicle {
  id                     String          @id @default(uuid(7)) @db.Uuid
  userId                 String          @map("user_id") @db.Uuid
  make                   String
  model                  String
  variant                String?
  manufacturingYear      Int             @map("manufacturing_year") @db.SmallInt
  category               VehicleCategory
  /// Normalised (upper-case, no separators), e.g. HR26EV4821.
  registrationNumber     String          @map("registration_number")
  registrationDate       DateTime?       @map("registration_date") @db.Date
  fuelType               FuelType        @map("fuel_type")
  transmission           Transmission
  engineCapacityCc       Int?            @map("engine_capacity_cc")
  engineConfiguration    String?         @map("engine_configuration")
  fuelTankCapacityL      Int?            @map("fuel_tank_capacity_l") @db.SmallInt
  colour                 String?
  ownershipType          OwnershipType   @map("ownership_type")
  purchaseDate           DateTime?       @map("purchase_date") @db.Date
  purchasePrice          Decimal?        @map("purchase_price") @db.Decimal(12, 2)
  /// Highest known reading: set by the user, raised by fuel entries (never lowered by them).
  odometerKm             Int             @map("odometer_km")
  vin                    String?
  engineNumber           String?         @map("engine_number")
  fuelSpecification      String?         @map("fuel_specification")
  engineOilSpecification String?         @map("engine_oil_specification")
  tyreSize               String?         @map("tyre_size")
  batteryType            String?         @map("battery_type")
  warrantyExpiryDate     DateTime?       @map("warranty_expiry_date") @db.Date
  warrantyKmLimit        Int?            @map("warranty_km_limit")
  notes                  String?
  /// Set when archived: hidden from the switcher, records kept, restorable.
  archivedAt             DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fuelEntries FuelEntry[]
  expenses    Expense[]

  @@unique([userId, registrationNumber])
  @@index([userId, archivedAt])
  @@map("vehicles")
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  NET_BANKING
  WALLET
  OTHER
}

/// A fill-up or charge (MODULES.md M3). Mirrors `createFuelEntrySchema` in @automate/shared.
/// Mileage is derived from the vehicle's whole history by the API, never stored.
/// CHECK constraints (positive amounts, non-negative odometer) are in the migration SQL.
model FuelEntry {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  vehicleId      String         @map("vehicle_id") @db.Uuid
  filledAt       DateTime       @map("filled_at") @db.Timestamptz(3)
  odometerKm     Int            @map("odometer_km")
  fuelType       FuelType       @map("fuel_type")
  /// Litres, kg (CNG) or kWh (electric).
  quantity       Decimal        @db.Decimal(10, 3)
  pricePerUnit   Decimal        @map("price_per_unit") @db.Decimal(10, 3)
  /// What was paid (may differ from quantity × price by pump rounding).
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  isFullTank     Boolean        @map("is_full_tank")
  /// A fill-up before this one wasn't logged: the mileage sequence restarts here.
  missedPrevious Boolean        @default(false) @map("missed_previous")
  stationName    String?        @map("station_name")
  /// Where it happened: the device's position when the add form opened (a pair, or both null).
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  /// Address looked up for the coordinates; never typed by the user.
  location       String?
  paymentMethod  PaymentMethod? @map("payment_method")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Histories are read per vehicle in date order; also serves the cascade from vehicles.
  @@index([vehicleId, filledAt])
  @@map("fuel_entries")
}

enum CostClass {
  OPERATING
  OWNERSHIP
  FINANCING
  CAPITAL
}

enum ExpenseSource {
  MANUAL
  FUEL
  MAINTENANCE
  TRIP
  RECURRING
  IMPORT
}

enum ExpenseKind {
  EXPENSE
  REFUND
}

enum RefundReason {
  REFUND
  REIMBURSEMENT
  ADJUSTMENT
}

/// Expense categories (MODULES.md M4). System rows (userId null, `key` set) are seeded from
/// SYSTEM_EXPENSE_CATEGORIES in @automate/shared; users add custom ones. Two levels: a category
/// and its subcategories, which inherit the parent's cost class.
/// Names are unique per owner and parent, case-insensitively (index in the migration SQL).
model ExpenseCategory {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  /// System categories only, e.g. "DAILY_USAGE.TOLL". Code refers to categories by key.
  key       String?    @unique
  name      String
  /// One of EXPENSE_ICONS.
  icon      String
  /// Top-level only; subcategories inherit it.
  costClass CostClass? @map("cost_class")
  /// Disabled: kept for history, not offered for new expenses (custom categories only).
  active    Boolean    @default(true)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        ExpenseCategory?  @relation("ExpenseSubcategories", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories ExpenseCategory[] @relation("ExpenseSubcategories")
  expenses      Expense[]         @relation("ExpenseCategory")
  subExpenses   Expense[]         @relation("ExpenseSubcategory")

  @@index([userId])
  @@index([parentId])
  @@map("expense_categories")
}

/// Money spent on a vehicle (MODULES.md M4). Records from other modules (fuel, service, trips)
/// link here by (source, sourceId) and are edited in their own module. A shared expense is one
/// row per vehicle with the same sharedGroupId; a refund is its own row pointing at the original.
/// CHECK constraints (amounts, the finance split, refund shape) are in the migration SQL.
model Expense {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  vehicleId       String         @map("vehicle_id") @db.Uuid
  kind            ExpenseKind    @default(EXPENSE)
  title           String
  /// Always positive; a refund reduces net spending by its amount.
  amount          Decimal        @db.Decimal(12, 2)
  date            DateTime       @db.Date
  categoryId      String         @map("category_id") @db.Uuid
  subcategoryId   String?        @map("subcategory_id") @db.Uuid
  paymentMethod   PaymentMethod? @map("payment_method")
  vendor          String?
  odometerKm      Int?           @map("odometer_km")
  description     String?
  notes           String?
  source          ExpenseSource  @default(MANUAL)
  sourceId        String?        @map("source_id") @db.Uuid
  sharedGroupId   String?        @map("shared_group_id") @db.Uuid
  refundOfId      String?        @map("refund_of_id") @db.Uuid
  refundReason    RefundReason?  @map("refund_reason")
  /// Finance: the split of a loan payment (adds up to amount). Principal is never a cost.
  principalAmount Decimal?       @map("principal_amount") @db.Decimal(12, 2)
  interestAmount  Decimal?       @map("interest_amount") @db.Decimal(12, 2)
  chargesAmount   Decimal?       @map("charges_amount") @db.Decimal(12, 2)
  loanReference   String?        @map("loan_reference")
  loanOutstanding Decimal?       @map("loan_outstanding") @db.Decimal(12, 2)
  serviceType     String?        @map("service_type")
  partsReplaced   String?        @map("parts_replaced")
  partsAmount     Decimal?       @map("parts_amount") @db.Decimal(12, 2)
  labourAmount    Decimal?       @map("labour_amount") @db.Decimal(12, 2)
  warrantyUntil   DateTime?      @map("warranty_until") @db.Date
  provider        String?
  policyNumber    String?        @map("policy_number")
  policyStart     DateTime?      @map("policy_start") @db.Date
  policyEnd       DateTime?      @map("policy_end") @db.Date
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    ExpenseCategory  @relation("ExpenseCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory ExpenseCategory? @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  refundOf    Expense?         @relation("ExpenseRefunds", fields: [refundOfId], references: [id], onDelete: Cascade)
  refunds     Expense[]        @relation("ExpenseRefunds")

  /// One expense per linked record: a fill-up can never be counted twice.
  @@unique([source, sourceId])
  @@index([userId, date])
  @@index([vehicleId, date])
  @@index([sharedGroupId])
  @@index([refundOfId])
  @@map("expenses")
}
