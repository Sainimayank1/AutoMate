// Conventions: docs/architecture/database.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased (the shared schema normalises it), so uniqueness is case-insensitive.
  email           String   @unique
  /// argon2id hash. The plain password is never stored or logged.
  passwordHash    String   @map("password_hash")
  name            String
  termsAcceptedAt DateTime @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  vehicles    Vehicle[]
  fuelEntries FuelEntry[]

  @@map("users")
}

/// One signed-in device. Holds only the SHA-256 hash of its refresh token, which rotates on every refresh.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  /// "Keep me signed in": a 30-day persistent cookie instead of a browser-session cookie.
  persistent Boolean
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AMT
  IMT
  CVT
  DCT
  AUTOMATIC
}

enum VehicleCategory {
  HATCHBACK
  SEDAN
  SUV
  MUV
  OTHER
}

enum OwnershipType {
  OWNED
  FINANCED
}

/// A vehicle in a user's garage (MODULES.md M2). Mirrors `createVehicleSchema` in @automate/shared.
model Vehicle {
  id                     String          @id @default(uuid(7)) @db.Uuid
  userId                 String          @map("user_id") @db.Uuid
  make                   String
  model                  String
  variant                String?
  manufacturingYear      Int             @map("manufacturing_year") @db.SmallInt
  category               VehicleCategory
  /// Normalised (upper-case, no separators), e.g. HR26EV4821.
  registrationNumber     String          @map("registration_number")
  registrationDate       DateTime?       @map("registration_date") @db.Date
  fuelType               FuelType        @map("fuel_type")
  transmission           Transmission
  engineCapacityCc       Int?            @map("engine_capacity_cc")
  engineConfiguration    String?         @map("engine_configuration")
  fuelTankCapacityL      Int?            @map("fuel_tank_capacity_l") @db.SmallInt
  colour                 String?
  ownershipType          OwnershipType   @map("ownership_type")
  purchaseDate           DateTime?       @map("purchase_date") @db.Date
  purchasePrice          Decimal?        @map("purchase_price") @db.Decimal(12, 2)
  /// Highest known reading: set by the user, raised by fuel entries (never lowered by them).
  odometerKm             Int             @map("odometer_km")
  vin                    String?
  engineNumber           String?         @map("engine_number")
  fuelSpecification      String?         @map("fuel_specification")
  engineOilSpecification String?         @map("engine_oil_specification")
  tyreSize               String?         @map("tyre_size")
  batteryType            String?         @map("battery_type")
  warrantyExpiryDate     DateTime?       @map("warranty_expiry_date") @db.Date
  warrantyKmLimit        Int?            @map("warranty_km_limit")
  notes                  String?
  /// Set when archived: hidden from the switcher, records kept, restorable.
  archivedAt             DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fuelEntries FuelEntry[]

  @@unique([userId, registrationNumber])
  @@index([userId, archivedAt])
  @@map("vehicles")
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  NET_BANKING
  WALLET
  OTHER
}

/// A fill-up or charge (MODULES.md M3). Mirrors `createFuelEntrySchema` in @automate/shared.
/// Mileage is derived from the vehicle's whole history by the API, never stored.
/// CHECK constraints (positive amounts, non-negative odometer) are in the migration SQL.
model FuelEntry {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  vehicleId      String         @map("vehicle_id") @db.Uuid
  filledAt       DateTime       @map("filled_at") @db.Timestamptz(3)
  odometerKm     Int            @map("odometer_km")
  fuelType       FuelType       @map("fuel_type")
  /// Litres, kg (CNG) or kWh (electric).
  quantity       Decimal        @db.Decimal(10, 3)
  pricePerUnit   Decimal        @map("price_per_unit") @db.Decimal(10, 3)
  /// What was paid (may differ from quantity × price by pump rounding).
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  isFullTank     Boolean        @map("is_full_tank")
  /// A fill-up before this one wasn't logged: the mileage sequence restarts here.
  missedPrevious Boolean        @default(false) @map("missed_previous")
  stationName    String?        @map("station_name")
  /// Where it happened: the device's position when the add form opened (a pair, or both null).
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  /// Address looked up for the coordinates; never typed by the user.
  location       String?
  paymentMethod  PaymentMethod? @map("payment_method")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Histories are read per vehicle in date order; also serves the cascade from vehicles.
  @@index([vehicleId, filledAt])
  @@map("fuel_entries")
}
