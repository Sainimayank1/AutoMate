// Conventions: docs/architecture/database.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased (the shared schema normalises it), so uniqueness is case-insensitive.
  email           String   @unique
  /// argon2id hash. The plain password is never stored or logged.
  passwordHash    String   @map("password_hash")
  name            String
  /// The profile photo in private storage (users/<id>/<uuid>); null without one.
  avatarKey       String?  @map("avatar_key")
  termsAcceptedAt DateTime @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  vehicles             Vehicle[]
  fuelEntries          FuelEntry[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  maintenanceSchedules MaintenanceSchedule[]
  serviceRecords       ServiceRecord[]
  serviceProviders     ServiceProvider[]
  components           VehicleComponent[]
  inspections          Inspection[]
  preference           UserPreference?
  recurringExpenses    RecurringExpense[]
  vehicleLoans         VehicleLoan[]
  expenseBudgets       ExpenseBudget[]
  documents            Document[]
  documentFiles        DocumentFile[]
  notifications        Notification[]
  reminders            Reminder[]
  trips                Trip[]
  tripCategories       TripCategory[]
  tripCosts            TripCost[]
  tripAttachments      TripAttachment[]
  attachments          Attachment[]

  @@map("users")
}

/// A user's saved settings, one row per user (the dashboard layout now; Settings adds more).
model UserPreference {
  id                   String          @id @default(uuid(7)) @db.Uuid
  userId               String          @unique @map("user_id") @db.Uuid
  /// `DashboardLayout` (@automate/shared): an opaque payload, never filtered on, validated by the
  /// API on write and brought up to date on read. Null: the default layout.
  dashboard            Json?
  theme                ThemePreference @default(DARK)
  /// Opened first on sign-in; cleared when that vehicle is deleted.
  defaultVehicleId     String?         @map("default_vehicle_id") @db.Uuid
  /// Reminder switches (Notifications reads them). Off overall: no reminders at all.
  notifyEnabled        Boolean         @default(true) @map("notify_enabled")
  notifyDocuments      Boolean         @default(true) @map("notify_documents")
  notifyMaintenance    Boolean         @default(true) @map("notify_maintenance")
  notifyPayments       Boolean         @default(true) @map("notify_payments")
  notifyTrips          Boolean         @default(true) @map("notify_trips")
  notifyMonthlySummary Boolean         @default(false) @map("notify_monthly_summary")
  notifyFuel           Boolean         @default(true) @map("notify_fuel")
  /// Dashboard action-centre items the user dismissed ("<vehicleId>:<itemId>"); information only.
  dashboardDismissed   String[]        @default([]) @map("dashboard_dismissed")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultVehicle Vehicle? @relation(fields: [defaultVehicleId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

/// One signed-in device. Holds only the SHA-256 hash of its refresh token, which rotates on every refresh.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  /// "Keep me signed in": a 30-day persistent cookie instead of a browser-session cookie.
  persistent Boolean
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AMT
  IMT
  CVT
  DCT
  AUTOMATIC
}

enum VehicleCategory {
  HATCHBACK
  SEDAN
  SUV
  MUV
  OTHER
}

enum OwnershipType {
  OWNED
  FINANCED
}

/// A vehicle in a user's garage (MODULES.md M2). Mirrors `createVehicleSchema` in @automate/shared.
model Vehicle {
  id                     String          @id @default(uuid(7)) @db.Uuid
  userId                 String          @map("user_id") @db.Uuid
  make                   String
  model                  String
  variant                String?
  manufacturingYear      Int             @map("manufacturing_year") @db.SmallInt
  category               VehicleCategory
  /// Normalised (upper-case, no separators), e.g. HR26EV4821.
  registrationNumber     String          @map("registration_number")
  registrationDate       DateTime?       @map("registration_date") @db.Date
  fuelType               FuelType        @map("fuel_type")
  transmission           Transmission
  engineCapacityCc       Int?            @map("engine_capacity_cc")
  engineConfiguration    String?         @map("engine_configuration")
  fuelTankCapacityL      Int?            @map("fuel_tank_capacity_l") @db.SmallInt
  colour                 String?
  ownershipType          OwnershipType   @map("ownership_type")
  purchaseDate           DateTime?       @map("purchase_date") @db.Date
  purchasePrice          Decimal?        @map("purchase_price") @db.Decimal(12, 2)
  /// Highest known reading: set by the user, raised by fuel entries (never lowered by them).
  odometerKm             Int             @map("odometer_km")
  vin                    String?
  engineNumber           String?         @map("engine_number")
  fuelSpecification      String?         @map("fuel_specification")
  engineOilSpecification String?         @map("engine_oil_specification")
  tyreSize               String?         @map("tyre_size")
  batteryType            String?         @map("battery_type")
  warrantyExpiryDate     DateTime?       @map("warranty_expiry_date") @db.Date
  warrantyKmLimit        Int?            @map("warranty_km_limit")
  notes                  String?
  /// Set when archived: hidden from the switcher, records kept, restorable.
  archivedAt             DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fuelEntries          FuelEntry[]
  expenses             Expense[]
  recurringExpenses    RecurringExpense[]
  vehicleLoans         VehicleLoan[]
  expenseBudgets       ExpenseBudget[]
  documents            Document[]
  preferredBy          UserPreference[]
  notifications        Notification[]
  reminders            Reminder[]
  maintenanceSchedules MaintenanceSchedule[]
  serviceRecords       ServiceRecord[]
  components           VehicleComponent[]
  inspections          Inspection[]
  trips                Trip[]

  @@unique([userId, registrationNumber])
  @@index([userId, archivedAt])
  @@map("vehicles")
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  NET_BANKING
  WALLET
  OTHER
}

/// A fill-up or charge (MODULES.md M3). Mirrors `createFuelEntrySchema` in @automate/shared.
/// Mileage is derived from the vehicle's whole history by the API, never stored.
/// CHECK constraints (positive amounts, non-negative odometer) are in the migration SQL.
model FuelEntry {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  vehicleId      String         @map("vehicle_id") @db.Uuid
  filledAt       DateTime       @map("filled_at") @db.Timestamptz(3)
  odometerKm     Int            @map("odometer_km")
  fuelType       FuelType       @map("fuel_type")
  /// Litres, kg (CNG) or kWh (electric).
  quantity       Decimal        @db.Decimal(10, 3)
  pricePerUnit   Decimal        @map("price_per_unit") @db.Decimal(10, 3)
  /// What was paid (may differ from quantity × price by pump rounding).
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  isFullTank     Boolean        @map("is_full_tank")
  /// A fill-up before this one wasn't logged: the mileage sequence restarts here.
  missedPrevious Boolean        @default(false) @map("missed_previous")
  stationName    String?        @map("station_name")
  /// Where it happened: the device's position when the add form opened (a pair, or both null).
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  /// Address looked up for the coordinates; never typed by the user.
  location       String?
  paymentMethod  PaymentMethod? @map("payment_method")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// The trip this fill-up was bought on (its actual fuel); unlinked when the trip goes.
  tripId  String? @map("trip_id") @db.Uuid
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  /// Histories are read per vehicle in date order; also serves the cascade from vehicles.
  @@index([tripId])
  @@index([vehicleId, filledAt])
  @@map("fuel_entries")
}

enum CostClass {
  OPERATING
  OWNERSHIP
  FINANCING
  CAPITAL
}

enum ExpenseSource {
  MANUAL
  FUEL
  MAINTENANCE
  TRIP
  RECURRING
  IMPORT
}

enum ExpenseKind {
  EXPENSE
  REFUND
}

enum RefundReason {
  REFUND
  REIMBURSEMENT
  ADJUSTMENT
}

/// Expense categories (MODULES.md M4). System rows (userId null, `key` set) are seeded from
/// SYSTEM_EXPENSE_CATEGORIES in @automate/shared; users add custom ones. Two levels: a category
/// and its subcategories, which inherit the parent's cost class.
/// Names are unique per owner and parent, case-insensitively (index in the migration SQL).
model ExpenseCategory {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  /// System categories only, e.g. "DAILY_USAGE.TOLL". Code refers to categories by key.
  key       String?    @unique
  name      String
  /// One of EXPENSE_ICONS.
  icon      String
  /// Top-level only; subcategories inherit it.
  costClass CostClass? @map("cost_class")
  /// Disabled: kept for history, not offered for new expenses (custom categories only).
  active    Boolean    @default(true)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        ExpenseCategory?   @relation("ExpenseSubcategories", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories ExpenseCategory[]  @relation("ExpenseSubcategories")
  expenses      Expense[]          @relation("ExpenseCategory")
  subExpenses   Expense[]          @relation("ExpenseSubcategory")
  recurring     RecurringExpense[] @relation("RecurringCategory")
  subRecurring  RecurringExpense[] @relation("RecurringSubcategory")
  budgets       ExpenseBudget[]

  @@index([userId])
  @@index([parentId])
  @@map("expense_categories")
}

/// Money spent on a vehicle (MODULES.md M4). Records from other modules (fuel, service, trips)
/// link here by (source, sourceId) and are edited in their own module. A shared expense is one
/// row per vehicle with the same sharedGroupId; a refund is its own row pointing at the original.
/// CHECK constraints (amounts, the finance split, refund shape) are in the migration SQL.
model Expense {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  vehicleId       String         @map("vehicle_id") @db.Uuid
  kind            ExpenseKind    @default(EXPENSE)
  title           String
  /// Always positive; a refund reduces net spending by its amount.
  amount          Decimal        @db.Decimal(12, 2)
  date            DateTime       @db.Date
  categoryId      String         @map("category_id") @db.Uuid
  subcategoryId   String?        @map("subcategory_id") @db.Uuid
  paymentMethod   PaymentMethod? @map("payment_method")
  vendor          String?
  odometerKm      Int?           @map("odometer_km")
  description     String?
  notes           String?
  source          ExpenseSource  @default(MANUAL)
  sourceId        String?        @map("source_id") @db.Uuid
  sharedGroupId   String?        @map("shared_group_id") @db.Uuid
  refundOfId      String?        @map("refund_of_id") @db.Uuid
  refundReason    RefundReason?  @map("refund_reason")
  /// Finance: the split of a loan payment (adds up to amount). Principal is never a cost.
  principalAmount Decimal?       @map("principal_amount") @db.Decimal(12, 2)
  interestAmount  Decimal?       @map("interest_amount") @db.Decimal(12, 2)
  chargesAmount   Decimal?       @map("charges_amount") @db.Decimal(12, 2)
  loanReference   String?        @map("loan_reference")
  loanOutstanding Decimal?       @map("loan_outstanding") @db.Decimal(12, 2)
  /// Finance: the loan this payment (EMI or prepayment) belongs to, when it's tracked here.
  loanId          String?        @map("loan_id") @db.Uuid
  serviceType     String?        @map("service_type")
  partsReplaced   String?        @map("parts_replaced")
  partsAmount     Decimal?       @map("parts_amount") @db.Decimal(12, 2)
  labourAmount    Decimal?       @map("labour_amount") @db.Decimal(12, 2)
  warrantyUntil   DateTime?      @map("warranty_until") @db.Date
  provider        String?
  policyNumber    String?        @map("policy_number")
  policyStart     DateTime?      @map("policy_start") @db.Date
  policyEnd       DateTime?      @map("policy_end") @db.Date
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    ExpenseCategory      @relation("ExpenseCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory ExpenseCategory?     @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  refundOf    Expense?             @relation("ExpenseRefunds", fields: [refundOfId], references: [id], onDelete: Cascade)
  refunds     Expense[]            @relation("ExpenseRefunds")
  attachments Attachment[]
  loan        VehicleLoan?         @relation(fields: [loanId], references: [id], onDelete: SetNull)
  occurrence  RecurringOccurrence?

  /// One expense per linked record: a fill-up can never be counted twice.
  @@unique([source, sourceId])
  @@index([userId, date])
  @@index([vehicleId, date])
  @@index([sharedGroupId])
  @@index([refundOfId])
  @@index([loanId])
  @@map("expenses")
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// A payment that repeats (an EMI, a premium, a parking pass). A schedule is never a payment: a due
/// date becomes an expense only when it's marked paid (docs/architecture/expenses.md §6).
model RecurringExpense {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  vehicleId     String          @map("vehicle_id") @db.Uuid
  title         String
  amount        Decimal         @db.Decimal(12, 2)
  categoryId    String          @map("category_id") @db.Uuid
  subcategoryId String?         @map("subcategory_id") @db.Uuid
  paymentMethod PaymentMethod?  @map("payment_method")
  vendor        String?
  notes         String?
  /// Every `every` units from `startDate` (the first due date), up to `endDate` when set.
  every         Int             @default(1)
  unit          RecurrenceUnit
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  /// A due date is "due" this many days ahead of it.
  reminderDays  Int             @default(3) @map("reminder_days")
  status        RecurringStatus @default(ACTIVE)
  /// Unpaid dates before this aren't owed: resuming a paused schedule starts it again from there.
  activeFrom    DateTime        @map("active_from") @db.Date
  /// The EMI schedule of a loan (its amount and dates follow the loan).
  loanId        String?         @unique @map("loan_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    ExpenseCategory       @relation("RecurringCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory ExpenseCategory?      @relation("RecurringSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  loan        VehicleLoan?          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  occurrences RecurringOccurrence[]

  @@index([userId, vehicleId])
  @@map("recurring_expenses")
}

/// A due date someone acted on: paid (its expense), skipped or postponed. Untouched due dates
/// aren't stored; they're worked out from the schedule.
model RecurringOccurrence {
  id          String    @id @default(uuid(7)) @db.Uuid
  recurringId String    @map("recurring_id") @db.Uuid
  /// The scheduled date: the occurrence's identity, even when postponed.
  dueDate     DateTime  @map("due_date") @db.Date
  postponedTo DateTime? @map("postponed_to") @db.Date
  skipped     Boolean   @default(false)
  /// The payment (source RECURRING, sourceId = this id). Deleting it makes the date unpaid again.
  expenseId   String?   @unique @map("expense_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  recurring RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  expense   Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([recurringId, dueDate])
  @@map("recurring_occurrences")
}

enum DocumentType {
  REGISTRATION
  INSURANCE
  PUC
  DRIVING_LICENCE
  WARRANTY
  ROADSIDE_ASSISTANCE
  LOAN
  SERVICE_INVOICE
  PURCHASE_INVOICE
  OTHER
}

/// A vehicle's paper (or the owner's, like a driving licence) with its dates and reminders (M6).
/// Its state (valid, expiring, expired) is worked out from the expiry date, never stored.
model Document {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  /// null for a driving licence, or once its vehicle is deleted (the document and files stay).
  vehicleId    String?      @map("vehicle_id") @db.Uuid
  type         DocumentType
  name         String
  number       String?
  issuer       String?
  issueDate    DateTime?    @map("issue_date") @db.Date
  expiryDate   DateTime?    @map("expiry_date") @db.Date
  notes        String?
  /// Days before expiry to remind on.
  reminderDays Int[]        @default([30, 7, 1]) @map("reminder_days")
  /// A reminder on a date of the user's choosing.
  remindOn     DateTime?    @map("remind_on") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  files   DocumentFile[]

  @@index([userId, vehicleId])
  @@index([userId, expiryDate])
  @@map("documents")
}

/// A file in private storage: only its key and metadata live here, never its bytes. Uploaded first
/// (pending until confirmed), then attached to a document.
model DocumentFile {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  documentId  String?   @map("document_id") @db.Uuid
  /// users/<userId>/<uuid>: server-made; the client's file name is metadata only.
  key         String    @unique
  fileName    String    @map("file_name")
  contentType String    @map("content_type")
  size        Int
  /// Set once the upload is checked (it exists, its size and real type match).
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, documentId])
  @@map("document_files")
}

enum BudgetPeriod {
  MONTH
  YEAR
}

/// A spending limit for one vehicle per IST month or year, overall (no category) or for one main
/// category (Expenses phase 5). Spending is worked out on read, never stored.
model ExpenseBudget {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  vehicleId    String       @map("vehicle_id") @db.Uuid
  /// null: everything on the vehicle. One budget per vehicle and category (checked under the
  /// vehicle lock, since NULLs don't clash in a unique index).
  categoryId   String?      @map("category_id") @db.Uuid
  period       BudgetPeriod @default(MONTH)
  amount       Decimal      @db.Decimal(12, 2)
  /// Warn once spending reaches this % of the limit.
  alertPercent Int          @default(80) @map("alert_percent")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, categoryId])
  @@index([userId, vehicleId])
  @@map("expense_budgets")
}

enum LoanMethod {
  /// Interest on the outstanding balance (Indian bank car loans).
  REDUCING
  /// Interest on the original principal for the whole tenure.
  FLAT
}

/// A vehicle loan: its terms, from which the amortisation schedule is worked out. EMIs and
/// prepayments are expenses tagged with the loan; its EMI schedule is a RecurringExpense.
model VehicleLoan {
  id            String     @id @default(uuid(7)) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  vehicleId     String     @map("vehicle_id") @db.Uuid
  lender        String
  accountNumber String?    @map("account_number")
  principal     Decimal    @db.Decimal(12, 2)
  /// % a year.
  annualRate    Decimal    @map("annual_rate") @db.Decimal(5, 2)
  tenureMonths  Int        @map("tenure_months")
  firstEmiDate  DateTime   @map("first_emi_date") @db.Date
  method        LoanMethod @default(REDUCING)
  processingFee Decimal?   @map("processing_fee") @db.Decimal(12, 2)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rateChanges LoanRateChange[]
  payments    Expense[]
  recurring   RecurringExpense?

  @@index([userId, vehicleId])
  @@map("vehicle_loans")
}

/// A floating-rate change from a date: the EMI stays and the tenure moves, or the reverse.
model LoanRateChange {
  id            String   @id @default(uuid(7)) @db.Uuid
  loanId        String   @map("loan_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  annualRate    Decimal  @map("annual_rate") @db.Decimal(5, 2)
  /// true: keep the EMI and change the tenure (the usual bank default); false: keep the tenure.
  keepEmi       Boolean  @default(true) @map("keep_emi")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  loan VehicleLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, effectiveFrom])
  @@map("loan_rate_changes")
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
}

/// A maintenance task (MODULES.md M5) that repeats (every intervalKm and/or intervalMonths) or
/// happens once (at dueDate and/or dueKm), whichever comes first. Mirrors `createScheduleSchema`.
/// Next due and status are computed on read (schedule-engine.ts), never stored.
/// CHECK constraints (repeats xor once, positive intervals) are in the migration SQL.
model MaintenanceSchedule {
  id               String              @id @default(uuid(7)) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  vehicleId        String              @map("vehicle_id") @db.Uuid
  name             String
  /// One of MAINTENANCE_CATEGORY_KEYS, e.g. "BRAKES.BRAKE_PADS".
  categoryKey      String              @map("category_key")
  intervalKm       Int?                @map("interval_km")
  intervalMonths   Int?                @map("interval_months") @db.SmallInt
  dueDate          DateTime?           @map("due_date") @db.Date
  dueKm            Int?                @map("due_km")
  /// Repeating only: when it was last done before being added, if the user knows.
  lastDoneDate     DateTime?           @map("last_done_date") @db.Date
  lastDoneKm       Int?                @map("last_done_km")
  /// The vehicle's odometer when added: the distance basis until a "last done" or completion.
  addedOdometerKm  Int                 @map("added_odometer_km")
  remindersEnabled Boolean             @default(true) @map("reminders_enabled")
  /// Null: DEFAULT_REMINDER_LEAD. Also sets when the schedule shows as "due soon".
  leadDays         Int?                @map("lead_days") @db.SmallInt
  leadKm           Int?                @map("lead_km")
  priority         MaintenancePriority @default(NORMAL)
  /// The tracked part it watches; cleared if the part is deleted.
  componentId      String?             @map("component_id") @db.Uuid
  notes            String?
  pausedAt         DateTime?           @map("paused_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Record items that completed it: its history and the basis of its next due.
  completions ServiceRecordItem[]
  component   VehicleComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  /// Inspection findings it follows up.
  findings    InspectionItem[]

  /// Read per vehicle (all of a vehicle's schedules are computed together); serves the cascade.
  @@index([vehicleId])
  @@map("maintenance_schedules")
}

enum ServiceRecordType {
  ROUTINE_SERVICE
  PREVENTIVE
  INSPECTION
  REPAIR
  COMPONENT_REPLACEMENT
  EMERGENCY_REPAIR
  WARRANTY_REPAIR
  MODIFICATION
  OTHER
}

enum ProviderType {
  AUTHORISED
  INDEPENDENT
  TYRES
  BATTERY
  BODY_SHOP
  DETAILING
  ROADSIDE
  OTHER
}

/// A workshop, dealer or mechanic of the user's, shared by their vehicles. Created from a record's
/// workshop name; names are unique per user, case-insensitively (index in the migration SQL).
model ServiceProvider {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  name       String
  type       ProviderType @default(OTHER)
  phone      String?
  email      String?
  address    String?
  city       String?
  /// Shown first in suggestions and lists.
  preferred  Boolean      @default(false)
  notes      String?
  /// Hidden from suggestions; its history stays.
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  records     ServiceRecord[]
  components  VehicleComponent[]
  inspections Inspection[]

  @@index([userId])
  @@map("service_providers")
}

/// Work done on a vehicle (MODULES.md M5 D): a service, repair, inspection or replacement, any date
/// (historical records welcome). Mirrors `createServiceRecordSchema`. Its money, when there is any,
/// is one linked expense (source MAINTENANCE). CHECK constraints are in the migration SQL.
model ServiceRecord {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  vehicleId      String            @map("vehicle_id") @db.Uuid
  type           ServiceRecordType
  title          String
  /// One of MAINTENANCE_CATEGORY_KEYS.
  categoryKey    String            @map("category_key")
  serviceDate    DateTime          @map("service_date") @db.Date
  odometerKm     Int?              @map("odometer_km")
  providerId     String?           @map("provider_id") @db.Uuid
  technician     String?
  description    String?
  labourAmount   Decimal?          @map("labour_amount") @db.Decimal(12, 2)
  partsAmount    Decimal?          @map("parts_amount") @db.Decimal(12, 2)
  otherAmount    Decimal?          @map("other_amount") @db.Decimal(12, 2)
  taxAmount      Decimal?          @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal?          @map("discount_amount") @db.Decimal(12, 2)
  /// Computed by the API (serviceRecordTotal); 0 when nothing was paid.
  totalAmount    Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod?    @map("payment_method")
  warrantyUntil  DateTime?         @map("warranty_until") @db.Date
  warrantyNotes  String?           @map("warranty_notes")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider    ServiceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  items       ServiceRecordItem[]
  attachments Attachment[]
  /// Parts this record fitted (replacements) and lifecycle events it backs.
  installed   VehicleComponent[]
  events      ComponentEvent[]

  /// Histories are read per vehicle in date order; also serves the cascade from vehicles.
  @@index([vehicleId, serviceDate])
  @@index([providerId])
  @@map("service_records")
}

/// One line of a record's work. With a schedule, it completes that schedule (once per record).
model ServiceRecordItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  recordId    String   @map("record_id") @db.Uuid
  position    Int      @db.SmallInt
  name        String
  partNumber  String?  @map("part_number")
  scheduleId  String?  @map("schedule_id") @db.Uuid
  /// The tracked part this work was on (its lifecycle lists the record).
  componentId String?  @map("component_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  record    ServiceRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  /// Deleting a schedule keeps the record; the item just stops pointing at it.
  schedule  MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  component VehicleComponent?    @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@unique([recordId, scheduleId])
  @@index([scheduleId])
  @@index([componentId])
  @@map("service_record_items")
}

enum ComponentCondition {
  NEW
  GOOD
  MONITORING
  NEEDS_ATTENTION
  REPLACE_SOON
  FAILED
  UNKNOWN
}

enum ComponentState {
  INSTALLED
  REPLACED
  REMOVED
}

enum ComponentEventType {
  INSTALLED
  INSPECTED
  REPLACED
  REMOVED
}

/// A tracked part of a vehicle (MODULES.md M5 B): fitted, inspected, then replaced or removed.
/// A replaced part is kept (state REPLACED, replacedById → its successor); history is never
/// overwritten. Status and estimated life are computed on read (component-life.ts).
model VehicleComponent {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  vehicleId          String             @map("vehicle_id") @db.Uuid
  /// One of COMPONENT_KIND_KEYS.
  kind               String
  name               String
  position           String?
  brand              String?
  partNumber         String?            @map("part_number")
  installedAt        DateTime?          @map("installed_at") @db.Date
  installedKm        Int?               @map("installed_km")
  providerId         String?            @map("provider_id") @db.Uuid
  /// The service record that fitted it (a replacement).
  installRecordId    String?            @map("install_record_id") @db.Uuid
  expectedLifeKm     Int?               @map("expected_life_km")
  expectedLifeMonths Int?               @map("expected_life_months") @db.SmallInt
  warrantyUntil      DateTime?          @map("warranty_until") @db.Date
  warrantyKm         Int?               @map("warranty_km")
  condition          ComponentCondition @default(UNKNOWN)
  state              ComponentState     @default(INSTALLED)
  removedAt          DateTime?          @map("removed_at") @db.Date
  removedKm          Int?               @map("removed_km")
  replacedById       String?            @unique @map("replaced_by_id") @db.Uuid
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider        ServiceProvider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  installRecord   ServiceRecord?        @relation(fields: [installRecordId], references: [id], onDelete: SetNull)
  replacedBy      VehicleComponent?     @relation("ComponentReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces        VehicleComponent?     @relation("ComponentReplacement")
  events          ComponentEvent[]
  attachments     Attachment[]
  schedules       MaintenanceSchedule[]
  recordItems     ServiceRecordItem[]
  inspectionItems InspectionItem[]

  /// Read per vehicle; serves the cascade.
  @@index([vehicleId, state])
  @@index([installRecordId])
  @@map("vehicle_components")
}

/// A lifecycle step of a component: fitted, inspected (condition), replaced or removed.
model ComponentEvent {
  id          String              @id @default(uuid(7)) @db.Uuid
  componentId String              @map("component_id") @db.Uuid
  type        ComponentEventType
  date        DateTime            @db.Date
  odometerKm  Int?                @map("odometer_km")
  condition   ComponentCondition?
  /// The service record behind it (a replacement); kept as history if that record is deleted.
  recordId    String?             @map("record_id") @db.Uuid
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  component VehicleComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  record    ServiceRecord?   @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([componentId, date])
  @@index([recordId])
  @@map("component_events")
}

enum InspectionKind {
  SELF_CHECK
  PROFESSIONAL
}

enum InspectionCondition {
  GOOD
  NORMAL
  MONITOR
  ATTENTION
  REPLACE_SOON
  REPLACED
  NOT_INSPECTED
}

/// A checklist inspection (MODULES.md M5; condition monitoring): the user's own check or a
/// workshop's, kept apart by `kind`. Mirrors `createInspectionSchema`.
model Inspection {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  vehicleId    String         @map("vehicle_id") @db.Uuid
  kind         InspectionKind
  /// One of INSPECTION_TEMPLATE_KEYS (the checklist it started from).
  templateKey  String         @map("template_key")
  title        String
  date         DateTime       @db.Date
  odometerKm   Int?           @map("odometer_km")
  inspector    String?
  providerId   String?        @map("provider_id") @db.Uuid
  followUpDate DateTime?      @map("follow_up_date") @db.Date
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider    ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  items       InspectionItem[]
  attachments Attachment[]

  @@index([vehicleId, date])
  @@index([providerId])
  @@map("inspections")
}

/// One checklist line and what was found.
model InspectionItem {
  id                 String              @id @default(uuid(7)) @db.Uuid
  inspectionId       String              @map("inspection_id") @db.Uuid
  position           Int                 @db.SmallInt
  /// One of INSPECTION_AREA_KEYS.
  area               String
  label              String
  condition          InspectionCondition
  notes              String?
  recommendedAction  String?             @map("recommended_action")
  componentId        String?             @map("component_id") @db.Uuid
  /// The schedule created to follow this finding up.
  followUpScheduleId String?             @map("follow_up_schedule_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  inspection       Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  component        VehicleComponent?    @relation(fields: [componentId], references: [id], onDelete: SetNull)
  followUpSchedule MaintenanceSchedule? @relation(fields: [followUpScheduleId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@index([componentId])
  @@index([followUpScheduleId])
  @@map("inspection_items")
}

enum TripMethod {
  ODOMETER
  DISTANCE
  ROUTE
}

/// Only COMPLETED trips count anywhere (distance, costs, odometer, dashboard).
enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
  CANCELLED
}

/// Trip types (MODULES.md M7): the system defaults (no user, a key) and each user's own. Names
/// are unique per user, case-insensitively (index in the migration SQL). Archived, never deleted.
model TripCategory {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  key        String?   @unique
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([userId])
  @@map("trip_categories")
}

/// A journey (MODULES.md M7): distance from two odometer readings or entered by the user. Its
/// readings join the vehicle's one odometer history (docs/architecture/trips.md).
model Trip {
  id                     String     @id @default(uuid(7)) @db.Uuid
  userId                 String     @map("user_id") @db.Uuid
  vehicleId              String     @map("vehicle_id") @db.Uuid
  categoryId             String     @map("category_id") @db.Uuid
  method                 TripMethod
  status                 TripStatus @default(COMPLETED)
  title                  String?
  date                   DateTime   @db.Date
  /// Overnight and multi-day trips; null when it ends the day it starts.
  endDate                DateTime?  @map("end_date") @db.Date
  /// "HH:MM", India time.
  startTime              String?    @map("start_time")
  endTime                String?    @map("end_time")
  startKm                Int?       @map("start_km")
  endKm                  Int?       @map("end_km")
  /// From the readings (method ODOMETER), as entered, or the route's; null until done (plans).
  distanceKm             Decimal?   @map("distance_km") @db.Decimal(6, 1)
  /// The plan (kept after it's done, for planned vs actual): distance, duration, assumptions and
  /// estimates. Never spending.
  plannedDistanceKm      Decimal?   @map("planned_distance_km") @db.Decimal(6, 1)
  plannedDurationMinutes Int?       @map("planned_duration_minutes")
  estMileage             Decimal?   @map("est_mileage") @db.Decimal(5, 2)
  estFuelPrice           Decimal?   @map("est_fuel_price") @db.Decimal(7, 2)
  estToll                Decimal?   @map("est_toll") @db.Decimal(12, 2)
  estParking             Decimal?   @map("est_parking") @db.Decimal(12, 2)
  estAccommodation       Decimal?   @map("est_accommodation") @db.Decimal(12, 2)
  estOther               Decimal?   @map("est_other") @db.Decimal(12, 2)
  origin                 String?
  destination            String?
  /// Set when the place was chosen from the search (OpenStreetMap).
  originLat              Decimal?   @map("origin_lat") @db.Decimal(9, 6)
  originLng              Decimal?   @map("origin_lng") @db.Decimal(9, 6)
  destinationLat         Decimal?   @map("destination_lat") @db.Decimal(9, 6)
  destinationLng         Decimal?   @map("destination_lng") @db.Decimal(9, 6)
  /// Method ROUTE: the provider's route (encoded polyline, precision 6) the distance came from.
  routeProvider          String?    @map("route_provider")
  routeGeometry          String?    @map("route_geometry")
  routeDurationMinutes   Int?       @map("route_duration_minutes")
  notes                  String?
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    TripCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costs       TripCost[]
  fuelEntries FuelEntry[]
  stops       TripStop[]
  attachments TripAttachment[]

  @@index([vehicleId, date])
  @@index([userId, status, date])
  @@index([categoryId])
  @@map("trips")
}

enum TripCostCategory {
  TOLL
  PARKING
  FOOD
  ACCOMMODATION
  OTHER
}

/// A cost of a trip (docs/architecture/trips.md §1). Toll, parking and other have one linked
/// expense (source TRIP, sourceId = this id); food and accommodation stay with the trip.
model TripCost {
  id            String           @id @default(uuid(7)) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  tripId        String           @map("trip_id") @db.Uuid
  category      TripCostCategory
  amount        Decimal          @db.Decimal(12, 2)
  date          DateTime         @db.Date
  vendor        String?
  paymentMethod PaymentMethod?   @map("payment_method")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attachments TripAttachment[]

  @@index([tripId])
  @@index([userId, date])
  @@map("trip_costs")
}

/// A trip's photo or receipt (optionally a cost's): the browser uploads it straight to storage.
model TripAttachment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  /// The cost it's the receipt for, if any (removed with the cost).
  costId      String?   @map("cost_id") @db.Uuid
  /// users/<userId>/<uuid>: server-made; the client's file name is metadata only.
  key         String    @unique
  fileName    String    @map("file_name")
  contentType String    @map("content_type")
  size        Int
  /// Set once the upload is checked (it exists, its size and real type match).
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cost TripCost? @relation(fields: [costId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@map("trip_attachments")
}

/// A stop between a trip's origin and destination, in order (replaced whole on edit).
model TripStop {
  id            String   @id @default(uuid(7)) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  position      Int
  label         String
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  /// "HH:MM", India time.
  arrivalTime   String?  @map("arrival_time")
  departureTime String?  @map("departure_time")
  notes         String?
  /// Road trips: which day of the trip (1 = the start date); null = the previous stop's day.
  day           Int?
  /// Road trips: the night is spent here (the last stop of its day).
  overnight     Boolean  @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, position])
  @@map("trip_stops")
}

enum NotificationCategory {
  MAINTENANCE
  DOCUMENTS
  EXPENSES
  FUEL
  TRIPS
  REMINDERS
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

/// The in-app inbox (M10). Rows are raised from the modules' records when the inbox is read; the
/// dedupe key stops a reminder being raised twice and keeps a dismissal while it still applies.
model Notification {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  vehicleId    String?              @map("vehicle_id") @db.Uuid
  category     NotificationCategory
  kind         String               @db.VarChar(40)
  priority     NotificationPriority
  dedupeKey    String               @map("dedupe_key") @db.VarChar(200)
  title        String               @db.VarChar(200)
  body         String?              @db.VarChar(500)
  href         String?              @db.VarChar(300)
  /// When it (re)appeared: raised, or woken from a snooze.
  activeAt     DateTime             @map("active_at") @db.Timestamptz(3)
  readAt       DateTime?            @map("read_at") @db.Timestamptz(3)
  snoozedUntil DateTime?            @map("snoozed_until") @db.Timestamptz(3)
  dismissedAt  DateTime?            @map("dismissed_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, dismissedAt, activeAt])
  @@map("notifications")
}

/// A reminder the user set themselves (M10): a date, an optional vehicle, a lead in days.
model Reminder {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  vehicleId        String?   @map("vehicle_id") @db.Uuid
  title            String    @db.VarChar(120)
  dueDate          DateTime  @map("due_date") @db.Date
  remindDaysBefore Int       @default(1) @map("remind_days_before")
  notes            String?
  doneAt           DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId, doneAt, dueDate])
  @@map("reminders")
}

/// A receipt, invoice, job card or photo on an expense, service record, part or inspection.
/// Exactly one owner is set (the API makes sure); the file goes with its owner.
model Attachment {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  expenseId       String?   @map("expense_id") @db.Uuid
  serviceRecordId String?   @map("service_record_id") @db.Uuid
  componentId     String?   @map("component_id") @db.Uuid
  inspectionId    String?   @map("inspection_id") @db.Uuid
  /// users/<userId>/<uuid>: server-made; the client's file name is metadata only.
  key             String    @unique
  fileName        String    @map("file_name")
  contentType     String    @map("content_type")
  size            Int
  /// Set once the upload is checked (it exists, its size and real type match).
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense       Expense?          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  serviceRecord ServiceRecord?    @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  component     VehicleComponent? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  inspection    Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([serviceRecordId])
  @@index([componentId])
  @@index([inspectionId])
  @@index([confirmedAt, createdAt])
  @@map("attachments")
}

/// Stored objects whose row is gone (filled by delete triggers on the file tables); the storage
/// sweep deletes each object, then its row.
model StorageOrphan {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("storage_orphans")
}
