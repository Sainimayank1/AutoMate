{
  "name": "@automate/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "codegen": "pnpm --filter @automate/shared build && prisma generate",
    "predev": "pnpm codegen",
    "dev": "nest start --watch",
    "prebuild": "pnpm codegen",
    "build": "nest build",
    "start": "node dist/main.js",
    "prelint": "pnpm codegen",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "pretypecheck": "pnpm codegen",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm codegen",
    "test": "vitest run --dir src",
    "pretest:e2e": "pnpm codegen",
    "test:e2e": "vitest run --dir test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@automate/shared": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.2",
    "nestjs-zod": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
