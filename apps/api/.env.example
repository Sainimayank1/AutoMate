# Copy to apps/api/.env for local development. Never commit .env.
# Blank values fall back to defaults. Full reference: apps/api/README.md#environment-variables

NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automate

# Comma-separated allowed origins. "*" is rejected in production.
FRONTEND_URL=http://localhost:5173
# Reverse-proxy hops in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0
# Defaults to true outside production, false in production
SWAGGER_ENABLED=

# Required, min 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Refresh-token cookie SameSite: lax (default) | strict | none. Use none only when web and API
# are on different sites (e.g. *.pages.dev + *.onrender.com); it forces the Secure flag.
REFRESH_COOKIE_SAMESITE=

# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=debug

# Optional. When true, /health also checks Redis.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Reverse geocoding for the fuel form's location (Nominatim-compatible /reverse endpoint).
# Leave unset for the public OpenStreetMap server in development; use a keyed provider in production.
# GEOCODER_URL=https://us1.locationiq.com/v1/reverse
# GEOCODER_API_KEY=

# Driving routes for trips: an OSRM-compatible server (/route/v1/driving). The default public
# demo (https://router.project-osrm.org) is for development only; use a hosted or self-run OSRM
# in production. Trip place search uses the geocoder's sibling /search (same key).
# ROUTER_URL=https://router.project-osrm.org

# Document files. Outside production the default is `local`: files on disk under STORAGE_LOCAL_DIR,
# served through the API at STORAGE_PUBLIC_URL (default http://localhost:$PORT). For a private
# bucket set STORAGE_PROVIDER=r2 (or s3) and all of BUCKET, REGION (r2: auto), ACCESS_KEY,
# SECRET_KEY and ENDPOINT (r2: https://<account>.r2.cloudflarestorage.com). Production refuses local
# storage unless STORAGE_LOCAL_PERSISTENT=true says STORAGE_LOCAL_DIR is a persistent, backed-up
# volume (a self-hosted server; see docs/architecture/deployment.md).
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_LOCAL_DIR=.storage
STORAGE_LOCAL_PERSISTENT=false
STORAGE_PUBLIC_URL=

# Web Push (optional; all three or none). Generate keys with: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services
PUSH_CONTACT=
# Shared with the scheduled job that sends pushes (.github/workflows/notify.yml); 32+ characters
DISPATCH_SECRET=
