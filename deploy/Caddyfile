# AutoMate behind Caddy (docker-compose.prod.yml). SITE_ADDRESS (by default PUBLIC_URL) is the
# site address:
#   https://automate.example.com  -> automatic HTTPS (DNS must point here; ports 80 and 443 open)
#   http://localhost              -> plain HTTP, for trying the stack on your own machine
{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		-Server
	}

	# The API (and local file links, served through it).
	handle /api/* {
		reverse_proxy api:3000
	}

	# The single-page app: real files when they exist, index.html for every app route.
	handle {
		root * /srv
		@fingerprinted path /assets/*
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html /sw.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
