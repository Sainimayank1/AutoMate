# Settings for the production Docker stack (docker-compose.prod.yml).
# Copy to .env next to this file and fill in the required values. Never commit .env.
# Local development doesn't use this file: see apps/api/.env.example and apps/web/.env.example.
# Every API setting is explained in docs/development/environment-variables.md.

# ---- Required

# Where people open AutoMate. A https:// domain gets an automatic certificate (its DNS must
# point at this server, with ports 80 and 443 open). http://localhost tries the stack locally.
PUBLIC_URL=http://localhost

# Database password: letters and digits only (it goes into a URL). Generate with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs sign-in tokens; 32+ random characters. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# ---- Optional

# POSTGRES_USER=automate
# POSTGRES_DB=automate
# LOG_LEVEL=info
# SWAGGER_ENABLED=false

# Files: kept on the api-storage volume by default. To use a bucket instead:
# STORAGE_PROVIDER=r2
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Maps and places. The defaults are public OpenStreetMap services meant for light use;
# use your own or a keyed provider for real traffic.
# GEOCODER_URL=https://us1.locationiq.com/v1/reverse
# GEOCODER_API_KEY=
# ROUTER_URL=https://router.project-osrm.org
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Port 80 or 443 already taken on this machine (trying it locally)? Publish other ports, serve
# plain HTTP on any host name, and put the real address in PUBLIC_URL:
# HTTP_PORT=8080
# SITE_ADDRESS=:80
# PUBLIC_URL=http://localhost:8080

# Web Push (all three or none): npx web-push generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_CONTACT=mailto:you@example.com
# DISPATCH_SECRET=
